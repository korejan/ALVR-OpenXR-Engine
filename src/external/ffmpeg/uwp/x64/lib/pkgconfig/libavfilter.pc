prefix=../../../build/Win10UWP/x64
exec_prefix=${prefix}
libdir=../../../build/Win10UWP/x64/lib
includedir=../../../build/Win10UWP/x64/include

Name: libavfilter
Description: FFmpeg audio/video filtering library
Version: 12.1.101
Requires: 
Requires.private: libswscale >= 10.1.101, libavformat >= 63.1.101, libavcodec >= 63.1.101, libswresample >= 7.1.101, libavutil >= 61.1.101
Conflicts:
Libs: -L${libdir}  -lavfilter 
Libs.private: dxgi.lib d3d11.lib dxgi.lib d3d12.lib
Cflags: -I${includedir}
